generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo de Categoría
model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique @db.VarChar(80)
  description String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relación 1:N con Productos (Una categoría tiene muchos productos)
  products    Product[]

  @@map("categories")
}

// Modelo de Producto
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(150)
  description String?  @db.Text
  price       Float
  stock       Int      @default(0)
  sku         String   @unique @db.VarChar(50)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relación N:1 con Categoría (Cada producto pertenece a una categoría)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  // RELACION N:1 CON BRAND, CADA PRODUCTO TIENE UNA MARCA FABRICANTE
  brandId Int?
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  // RELACION 1:N CON REVIEW, CADA PRODUCTO TIENE 1 O VARIAS RESEÑAS
  reviews Review[]

  @@map("products")
}

// MODELO DE BRAND
model Brand {
  id Int @id @default(autoincrement())
  name String @db.VarChar(80) @unique
  country String? @db.VarChar(60)
  website String? @db.Text

  // RELACION 1:N CON PRODUCT
  products Product[]

  @@map("brands")
}

// MODELO DE REVIEW
model Review {
  id Int @id @default(autoincrement())
  author String @db.VarChar(100)
  rating Int // PENSE SE PODRIA COLOCAR UN RANGO EN PRISMA, PERO NO SE PUEDE
  comment String @db.VarChar(500)
  
  // RELACION N:1 CON PRODUCT, CADA PRODUCTO TIENE 1 O VARIAS RESEÑAS, PERO 1 RESEÑA ESTA ASOCIADA A 1 PRODUCTO 
  productId Int
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("reviews")
}